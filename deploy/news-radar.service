[Unit]
Description=新闻雷达 news-radar (FastAPI / uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_USER
Group=REPLACE_USER
WorkingDirectory=/opt/news-radar
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/news-radar/.venv/bin/uvicorn news_radar.app:app --host 0.0.0.0 --port 8770 --log-level info
Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
